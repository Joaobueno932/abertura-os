# O&M OS - variaveis de ambiente.
# Copie para .env e preencha. NUNCA versione o .env nem coloque valores reais aqui.

# --- Banco de dados (PostgreSQL / Neon) ---------------------------------------
# Conexao usada pela aplicacao em runtime. No Neon, prefira o endpoint POOLED
# (host com "-pooler"), que suporta muitas conexoes curtas.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require"

# Conexao DIRETA (host sem "-pooler"), usada por `prisma migrate` e introspecao.
# O pooler nao suporta os advisory locks do Prisma Migrate.
DIRECT_URL="postgresql://USUARIO:SENHA@HOST.REGIAO.aws.neon.tech/neondb?sslmode=require"

# --- Sessao -------------------------------------------------------------------
# Segredo que assina os cookies de sessao. OBRIGATORIO em producao (>= 32 chars).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# --- Regras de negocio --------------------------------------------------------
# Fuso usado na numeracao diaria da OS e na formatacao de datas.
NEXT_PUBLIC_APP_TIMEZONE="America/Campo_Grande"

# Caminho do .docx com o papel timbrado oficial da Em Conta Ltda.
OS_DOCX_TEMPLATE="EM CONTA_O&M_papel timbrado.docx"

# Opcional: caminho do LibreOffice para converter DOCX -> PDF com fidelidade 1:1.
# Vazio = PDF renderizado nativamente, sem dependencia de sistema operacional.
SOFFICE_PATH=""

# --- Administrador inicial ----------------------------------------------------
# Usado UMA vez pelo seed para provisionar o primeiro acesso. Nao existe senha
# padrao: sem INITIAL_ADMIN_PASSWORD o seed falha. O usuario criado precisa
# definir uma nova senha no primeiro login antes de usar o sistema.
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
INITIAL_ADMIN_NAME="Administrador"
